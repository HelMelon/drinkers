# PostgreSQL DSN
DATABASE_URL=postgres://user:password@localhost:5432/drinkers

# Пароль в админку. В production обязателен: без него API не стартует.
ADMIN_PASSWORD=admin
# Секрет для подписи токенов админки — на сервере обязательно свой
# (в production дефолтное значение запрещено)
ADMIN_SECRET=change-me
# Через какие origin можно ходить в API (список через запятую)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# production включает строгие проверки конфигурации
# NODE_ENV=production
# Порт API (по умолчанию 4000)
PORT=4000
